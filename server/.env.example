# Токен від @BotFather. Не вставляй його у web/.
BOT_TOKEN=

# Публічна HTTPS-адреса web/index.html. Її відкриватиме кнопка бота.
PUBLIC_URL=https://example.com

# Для локального браузерного тесту без Telegram. У production залиш 0.
ALLOW_DEV_AUTH=0
DEV_USER_ID=local

# Необов'язково: якщо frontend і API на різних доменах.
# CORS_ORIGIN=https://mini-app.example.com

PORT=3000
# DATA_FILE=./server/data/users.json

# Скільки секунд підпис initData вважається дійсним. За замовчуванням 86400
# (доба) — це забагато для Mini App, який відкривають на хвилину.
INIT_DATA_MAX_AGE=3600

# ----------------------------- AI -----------------------------
# Порожній AI_BASE_URL = AI вимкнено, кнопка в Mini App не показується.
# Підходить будь-який OpenAI-сумісний шлюз. Шлях /chat/completions
# дописується автоматично, тож URL має закінчуватись на /v1.
#
# Groq (обрано):          https://api.groq.com/openai/v1
# OpenRouter:             https://openrouter.ai/api/v1
# OmniRoute локально:     http://localhost:20128/v1
# OmniRoute у тому ж проєкті Railway: http://omniroute.railway.internal:20128/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Увага: Llama-моделі на Groq тепер Enterprise-only. На загальному доступі
# для чату лишились openai/gpt-oss-120b і openai/gpt-oss-20b.
AI_MODEL=openai/gpt-oss-120b

# gpt-oss — reasoning-моделі. Для розбору однієї фрази думати нема над чим,
# тож low. Значення off прибирає поле з запиту повністю.
AI_REASONING_EFFORT=low

# Bearer-токен шлюзу. OmniRoute на localhost його не вимагає,
# але щойно шлюз стає публічним — став ключ обов'язково.
AI_KEY=

# Захист квоти. Ліміт рахується на кожного Telegram-користувача окремо.
AI_DAILY_LIMIT=30
AI_MIN_GAP_MS=3000
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=900

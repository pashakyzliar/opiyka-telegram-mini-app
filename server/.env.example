# Токен від @BotFather. Не вставляй його у web/.
BOT_TOKEN=

# Публічна HTTPS-адреса web/index.html. Її відкриватиме кнопка бота.
PUBLIC_URL=https://example.com

# Для локального браузерного тесту без Telegram. У production залиш 0.
ALLOW_DEV_AUTH=0
DEV_USER_ID=local

# Необов'язково: якщо frontend і API на різних доменах.
# CORS_ORIGIN=https://mini-app.example.com

PORT=3000
# DATA_FILE=./server/data/users.json
